    "the-system-drawn-from-source--text-1": {
      "id": "the-system-drawn-from-source--text-1",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "the-system-drawn-from-source--text-1-l-54",
          "type": "list",
          "ordered": false,
          "children": [
            {
              "id": "the-system-drawn-from-source--text-1-li-55",
              "type": "listItem",
              "children": [
                {
                  "id": "the-system-drawn-from-source--text-1-p-56",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "The single false positive is a struct that shares a Protobuf service's name and method names, which the name-based matcher takes for an implementation."
                    }
                  ]
                }
              ]
            },
            {
              "id": "the-system-drawn-from-source--text-1-li-57",
              "type": "listItem",
              "children": [
                {
                  "id": "the-system-drawn-from-source--text-1-p-58",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Run time is set by the underlying SCIP indexer; gRPC matching is 3–5% of the indexing work."
                    }
                  ]
                }
              ]
            },
            {
              "id": "the-system-drawn-from-source--text-1-li-59",
              "type": "listItem",
              "children": [
                {
                  "id": "the-system-drawn-from-source--text-1-p-60",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "RPCover costs extra time only in C++, where the SCIP indexer analyses every translation unit; in Go, Python and TypeScript it is faster than the LSIF baseline."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
