  "narrations": {
    "a-call-loses-its-trail--narration": {
      "id": "a-call-loses-its-trail--narration",
      "content": [
        {
          "type": "text",
          "text": "A Go service calls a C++ service over gRPC. Ask a code indexer who answers that call, and the trail stops at the Go service's edge: it reads one language."
        }
      ]
    },
    "tracing-waits-for-traffic--narration": {
      "id": "tracing-waits-for-traffic--narration",
      "content": [
        {
          "type": "text",
          "text": "Tracing live traffic needs the whole system running, and still only sees the calls made while it watched."
        }
      ]
    },
    "the-shared-blueprint--narration": {
      "id": "the-shared-blueprint--narration",
      "content": [
        {
          "type": "text",
          "text": "Both ends, though, were generated from one blueprint, a Protocol Buffer definition. The Go client stub and the C++ server stub carry its service's names, so match both to it, and the trail continues."
        }
      ]
    },
    "every-service-one-map--narration": {
      "id": "every-service-one-map--narration",
      "content": [
        {
          "type": "text",
          "text": "RPCover does this for every service: standard indexers map each one, its gRPC Matcher joins the stubs across languages, and one merged index opens in a graph viewer."
        }
      ]
    },
    "the-system-drawn-from-source--narration": {
      "id": "the-system-drawn-from-source--narration",
      "content": [
        {
          "type": "text",
          "text": "Here is "
        },
        {
          "type": "pronunciation",
          "display": "DeathStarBench",
          "spoken": "Death Star Bench"
        },
        {
          "type": "text",
          "text": "'s hotel reservation system, drawn without running it. In two benchmarks across five languages, "
        },
        {
          "type": "pronunciation",
          "display": "RPCover",
          "spoken": "R P Cover"
        },
        {
          "type": "text",
          "text": " found all 149 gRPC calls: follow the shared definition, and no call gets lost."
        }
      ]
    }
  },
