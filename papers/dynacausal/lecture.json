  "narrations": {
    "which-service-broke--alarms--narration": {
      "id": "which-service-broke--alarms--narration",
      "content": [
        {
          "type": "text",
          "text": "Inject a network delay into an online shop, and alarms fire across its services. Payment and ads swing hardest."
        }
      ]
    },
    "which-service-broke--question--narration": {
      "id": "which-service-broke--question--narration",
      "content": [
        {
          "type": "text",
          "text": "So which one broke?"
        }
      ]
    },
    "the-loudest-are-victims--reveal--narration": {
      "id": "the-loudest-are-victims--reveal--narration",
      "content": [
        {
          "type": "text",
          "text": "Neither. The delay hit checkout, which only slowed down; the others were reacting to it."
        }
      ]
    },
    "the-loudest-are-victims--models--narration": {
      "id": "the-loudest-are-victims--models--narration",
      "content": [
        {
          "type": "text",
          "text": "Leading models "
        },
        {
          "type": "pronunciation",
          "display": "ART",
          "spoken": "A R T"
        },
        {
          "type": "text",
          "text": " and Eadro make the same guess: they rank services by how abnormal they look. In a cascade, the loudest service is often a victim."
        }
      ]
    },
    "follow-the-fault-upstream--windows--narration": {
      "id": "follow-the-fault-upstream--windows--narration",
      "content": [
        {
          "type": "text",
          "text": "DynaCausal ranks by cause instead. It redraws the call graph every time window, weighting each call by live request count and error rate, so a graph network can trace the fault upstream."
        }
      ]
    },
    "follow-the-fault-upstream--rank--narration": {
      "id": "follow-the-fault-upstream--rank--narration",
      "content": [
        {
          "type": "text",
          "text": "Training pushes the source above every service it affected."
        }
      ]
    },
    "where-to-look-first--bars--narration": {
      "id": "where-to-look-first--bars--narration",
      "content": [
        {
          "type": "text",
          "text": "On Train-Ticket, the true root cause comes first in 48 percent of cases, up from 30 for Eadro, whose graph never changes."
        }
      ]
    },
    "where-to-look-first--average--narration": {
      "id": "where-to-look-first--average--narration",
      "content": [
        {
          "type": "text",
          "text": "Across both benchmarks, the average is 0.63: the first service you check is more often where the cascade started."
        }
      ]
    }
  },
