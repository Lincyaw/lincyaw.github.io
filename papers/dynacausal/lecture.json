    "the-loudest-are-victims--scene": {
      "id": "the-loudest-are-victims--scene",
      "type": "component",
      "definitionId": "the-loudest-are-victims--scene--definition",
      "parameters": {
        "scene": "the-loudest-are-victims",
        "alt": "The question gives way to a ring on checkout, the root cause; ART and Eadro both score payment higher."
      }
    },
    "follow-the-fault-upstream-text-21": {
      "id": "follow-the-fault-upstream-text-21",
      "type": "text",
      "content": [
        {
          "id": "p-13",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "DynaCausal learns where a fault came from by reading the calls between services, window by window, rather than how loud each service is. It has three stages:"
            }
          ]
        },
        {
          "id": "list-14",
          "type": "list",
          "ordered": true,
          "children": [
            {
              "id": "li-15",
              "type": "listItem",
              "children": [
                {
                  "id": "p-16",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "A call graph per time window.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Metrics, logs and traces become one normalized time series per service; each call gets an edge weight from its live request count and error rate."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-17",
              "type": "listItem",
              "children": [
                {
                  "id": "p-18",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Hybrid-Aware GAT.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " A Transformer encodes each service over time; graph attention passes messages scaled by the dynamic edge weights, and an MLP scores every service."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-19",
              "type": "listItem",
              "children": [
                {
                  "id": "p-20",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Causal Representation Discrimination.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Temporal Causal Disentanglement contrasts each service with its own normal baseline; Spatial Causal Ordering ranks the root cause above the upstream and downstream services it affected."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "only": [
        "web"
      ]
    },
    "follow-the-fault-upstream-image-23": {
      "id": "follow-the-fault-upstream-image-23",
      "type": "image",
      "assetId": "follow-the-fault-upstream-asset-22",
      "alt": "The DynaCausal framework",
      "caption": [
        {
          "type": "text",
          "text": "The framework (Figure 3): dynamic alignment and representation learning on the left, the two causal losses and the ranking on the right."
        }
      ],
      "width": 100,
      "alignment": "center",
      "only": [
        "web"
      ]
    },
    "follow-the-fault-upstream--scene": {
      "id": "follow-the-fault-upstream--scene",
      "type": "component",
      "definitionId": "follow-the-fault-upstream--scene--definition",
      "parameters": {
        "scene": "follow-the-fault-upstream",
        "alt": "The graph is rebuilt per time window with calls weighted by traffic and errors; pulses trace the fault back to checkout, which rises to the top of the ranking."
      }
    },
    "where-to-look-first-text-49": {
      "id": "where-to-look-first-text-49",
      "type": "text",
      "content": [
        {
          "id": "p-24",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "How often the top-ranked service is the true root cause (AC@1, Table 1), against the strongest baseline, Eadro. Online Boutique is the RCAEval-RE2-OB benchmark with 90 faults; Train-Ticket has 1,430."
            }
          ]
        },
        {
          "id": "table-25",
          "type": "table",
          "headerRows": 1,
          "children": [
            {
              "id": "tr-26",
              "type": "tableRow",
              "children": [
                {
                  "id": "td-27",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "Benchmark"
                    }
                  ]
                },
                {
                  "id": "td-28",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "DynaCausal"
                    }
                  ]
                },
                {
                  "id": "td-29",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "Eadro"
                    }
                  ]
                },
                {
                  "id": "td-30",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "Gain"
                    }
                  ]
                }
              ]
            },
            {
              "id": "tr-31",
              "type": "tableRow",
              "children": [
                {
                  "id": "td-32",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "Online Boutique, 12 services"
                    }
                  ]
                },
                {
                  "id": "td-33",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "0.769",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "td-34",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "0.459"
                    }
                  ]
                },
                {
                  "id": "td-35",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "+0.310"
                    }
                  ]
                }
              ]
            },
            {
              "id": "tr-36",
              "type": "tableRow",
              "children": [
                {
                  "id": "td-37",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "Train-Ticket, 50 services"
                    }
                  ]
                },
                {
                  "id": "td-38",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "0.481",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "td-39",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "0.301"
                    }
                  ]
                },
                {
                  "id": "td-40",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "+0.180"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "p-41",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Mean reciprocal rank rises to 0.873 and 0.626 (from 0.570 for MicroRank and 0.467 for Eadro). What drives the gain:"
            }
          ]
        },
        {
          "id": "list-42",
          "type": "list",
          "ordered": false,
          "children": [
            {
              "id": "li-43",
              "type": "listItem",
              "children": [
                {
                  "id": "p-44",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "The dynamic graph matters most: replacing it with a static one costs the most, AC@1 0.481 to 0.395 on Train-Ticket (Table 2)."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-45",
              "type": "listItem",
              "children": [
                {
                  "id": "p-46",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Every component helps, and each matters more on the 50-service Train-Ticket system than on the 12-service shop."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-47",
              "type": "listItem",
              "children": [
                {
                  "id": "p-48",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Two Transformer layers and a ranking weight of 0.2 work best; deeper encoders overfit (Figure 4)."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "only": [
        "web"
      ]
    },
