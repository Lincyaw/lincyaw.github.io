  "blocks": {
    "one-incident-135-papers--scene": {
      "id": "one-incident-135-papers--scene",
      "type": "component",
      "definitionId": "one-incident-135-papers--scene--definition",
      "parameters": {
        "scene": "incident",
        "alt": "The paper's out-of-memory incident as three events, root cause, trigger and symptom, joined by the path RCA should recover; 135 surveyed papers above it, none returning the whole chain."
      }
    },
    "incident-card": {
      "id": "incident-card",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "p-1",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Aoyang Fang",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            },
            {
              "type": "text",
              "text": ", Haowen Yang, Haoze Dong, Qisheng Lu, Junjielong Xu, Pinjia He. arXiv preprint 2510.19593, 2025."
            }
          ]
        },
        {
          "id": "p-2",
          "type": "paragraph",
          "children": [
            {
              "type": "link",
              "href": "https://arxiv.org/abs/2510.19593",
              "children": [
                {
                  "type": "text",
                  "text": "arXiv"
                }
              ]
            },
            {
              "type": "text",
              "text": " · "
            },
            {
              "type": "link",
              "href": "https://arxiv.org/pdf/2510.19593",
              "children": [
                {
                  "type": "text",
                  "text": "PDF"
                }
              ]
            },
            {
              "type": "text",
              "text": " · "
            },
            {
              "type": "link",
              "href": "https://doi.org/10.48550/arXiv.2510.19593",
              "children": [
                {
                  "type": "text",
                  "text": "DOI"
                }
              ]
            }
          ]
        },
        {
          "id": "p-3",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Root cause analysis research explains points of an incident, not its path. Across "
            },
            {
              "type": "text",
              "text": "135 papers",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            },
            {
              "type": "text",
              "text": " from 2014 to 2025, sorted by the goal each one serves, none returns the complete incident propagation graph; most stop at the root cause."
            }
          ]
        }
      ]
    },
    "same-data-different-goals--scene": {
      "id": "same-data-different-goals--scene",
      "type": "component",
      "definitionId": "same-data-different-goals--scene--definition",
      "parameters": {
        "scene": "bins",
        "alt": "The 135 papers fall into three bins by input data (metrics, logs, traces); two papers from the same bin serve different events: the trigger, for an SRE restoring service, and the root cause, for a developer fixing it for good."
      }
    },
    "bins-text": {
      "id": "bins-text",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "p-4",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Earlier surveys sort RCA papers by the data they read. Input and objective are not one-to-one, so that sorting puts papers with different goals together and splits papers with the same goal. The difference shows in what each reader of an incident needs:"
            }
          ]
        }
      ]
    },
    "bins-columns": {
      "id": "bins-columns",
      "type": "container",
      "only": [
        "web"
      ],
      "layout": "columns",
      "children": [
        "bins-sre",
        "bins-dev"
      ],
      "properties": {
        "columnWidths": [
          1,
          1
        ]
      }
    },
    "bins-sre": {
      "id": "bins-sre",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "h-5",
          "type": "heading",
          "level": 3,
          "children": [
            {
              "type": "text",
              "text": "An SRE restoring service"
            }
          ]
        },
        {
          "id": "list-6",
          "type": "list",
          "ordered": false,
          "children": [
            {
              "id": "li-7",
              "type": "listItem",
              "children": [
                {
                  "id": "p-8",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Minimizes time to recovery"
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-9",
              "type": "listItem",
              "children": [
                {
                  "id": "p-10",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Needs the trigger, e.g. a traffic spike"
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-11",
              "type": "listItem",
              "children": [
                {
                  "id": "p-12",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Mitigating it is a quick fix"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "bins-dev": {
      "id": "bins-dev",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "h-13",
          "type": "heading",
          "level": 3,
          "children": [
            {
              "type": "text",
              "text": "A developer fixing it for good"
            }
          ]
        },
        {
          "id": "list-14",
          "type": "list",
          "ordered": false,
          "children": [
            {
              "id": "li-15",
              "type": "listItem",
              "children": [
                {
                  "id": "p-16",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Prevents the failure from coming back"
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-17",
              "type": "listItem",
              "children": [
                {
                  "id": "p-18",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Needs the root cause, e.g. a buggy commit"
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-19",
              "type": "listItem",
              "children": [
                {
                  "id": "p-20",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Resolving it is a permanent fix"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "sorted-by-goal--scene": {
      "id": "sorted-by-goal--scene",
      "type": "component",
      "definitionId": "sorted-by-goal--scene--definition",
      "parameters": {
        "scene": "goals",
        "alt": "The seven goals of the taxonomy form a ring round the incident and the papers move from the data bins to the goals; in the middle, the Effectiveness–Data–Cost triangle each line of work pushes along."
      }
    },
    "goals-figure": {
      "id": "goals-figure",
      "type": "image",
      "only": [
        "web"
      ],
      "assetId": "overview-asset",
      "alt": "Root cause analysis as observation, inference and result: monitoring units with code, configuration, resources and telemetry; RCA methods and metrics; an incident propagation graph of root causes, triggers and symptoms",
      "caption": [
        {
          "type": "text",
          "text": "Ideal RCA maps observations O to an incident propagation graph G (paper, Fig. 3). The root cause answers \"what\"; the paths answer \"how\" and \"why\"."
        }
      ],
      "width": 100,
      "alignment": "center"
    },
    "goals-text": {
      "id": "goals-text",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "p-21",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "From the incident management lifecycle the survey derives seven goals, and files each paper under the one it mainly pursues:"
            }
          ]
        },
        {
          "id": "list-22",
          "type": "list",
          "ordered": true,
          "children": [
            {
              "id": "li-23",
              "type": "listItem",
              "children": [
                {
                  "id": "p-24",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Multi-dimensional data correlation"
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-25",
              "type": "listItem",
              "children": [
                {
                  "id": "p-26",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Robustness"
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-27",
              "type": "listItem",
              "children": [
                {
                  "id": "p-28",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Adaptive learning"
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-29",
              "type": "listItem",
              "children": [
                {
                  "id": "p-30",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Real-time performance"
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-31",
              "type": "listItem",
              "children": [
                {
                  "id": "p-32",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Interpretability"
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-33",
              "type": "listItem",
              "children": [
                {
                  "id": "p-34",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Multi-granularity"
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-35",
              "type": "listItem",
              "children": [
                {
                  "id": "p-36",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Actionability"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "p-37",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "The goals are rational responses to one trade-off: better diagnosis needs more and better data, which costs more to collect and compute. They also interact. Causal graphs built for interpretability give actionability its basis; real-time performance tends to cost interpretability; adaptivity can work against robustness. Early work centred on real-time performance and multi-granularity; with LLMs the frontier moves to interpretability and actionability."
            }
          ]
        }
      ]
    },
    "points-not-the-path--scene": {
      "id": "points-not-the-path--scene",
      "type": "component",
      "definitionId": "points-not-the-path--scene--definition",
      "parameters": {
        "scene": "points",
        "alt": "The papers settle on the incident's events, most on the root cause; its edges stay dark, no paper returns the path. Resource faults are 56.9% of the root causes studied (Fig. 8)."
      }
    },
    "points-text": {
      "id": "points-text",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "p-38",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "More than half of the root causes studied are resource faults, which metrics reveal plainly; code (8.5%) and configuration (6.2%) together stay under 15%. Several foundational benchmarks are stale: TrainTicket has not been updated in over two years, and Sock Shop is archived."
            }
          ]
        },
        {
          "id": "p-39",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Three gaps stand between point-finding and graph-building RCA, and the survey's agenda follows them:"
            }
          ]
        },
        {
          "id": "list-40",
          "type": "list",
          "ordered": true,
          "children": [
            {
              "id": "li-41",
              "type": "listItem",
              "children": [
                {
                  "id": "p-42",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Benchmarks",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " whose incidents carry ground-truth propagation graphs."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-43",
              "type": "listItem",
              "children": [
                {
                  "id": "p-44",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Models",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " built for end-to-end causal graph generation."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-45",
              "type": "listItem",
              "children": [
                {
                  "id": "p-46",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Integration",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " with the software engineering lifecycle, from the graph back to the faulty commit and new regression tests."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "points-figure": {
      "id": "points-figure",
      "type": "image",
      "only": [
