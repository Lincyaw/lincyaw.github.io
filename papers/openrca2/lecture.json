      ],
      "content": [
        {
          "id": "p-1",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Aoyang Fang",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            },
            {
              "type": "text",
              "text": ", Yifan Yang, Jin'ao Shang, Qisheng Lu, Junjielong Xu, Rui Wang, Songhan Zhang, Yuzhong Zhang, Boxi Yu, Pinjia He. "
            },
            {
              "type": "text",
              "text": "arXiv preprint",
              "marks": [
                {
                  "type": "italic"
                }
              ]
            },
            {
              "type": "text",
              "text": ", 2026."
            }
          ]
        },
        {
          "id": "p-2",
          "type": "paragraph",
          "children": [
            {
              "type": "link",
              "href": "https://arxiv.org/abs/2606.27154",
              "children": [
                {
                  "type": "text",
                  "text": "arXiv"
                }
              ]
            },
            {
              "type": "text",
              "text": " · "
            },
            {
              "type": "link",
              "href": "https://arxiv.org/pdf/2606.27154",
              "children": [
                {
                  "type": "text",
                  "text": "PDF"
                }
              ]
            },
            {
              "type": "text",
              "text": " · "
            },
            {
              "type": "link",
              "href": "https://doi.org/10.48550/arXiv.2606.27154",
              "children": [
                {
                  "type": "text",
                  "text": "DOI"
                }
              ]
            }
          ]
        },
        {
          "id": "p-3",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "LLM agents name a correct root-cause service in "
            },
            {
              "type": "text",
              "text": "76.0%",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            },
            {
              "type": "text",
              "text": " of failures but connect it to the observed symptom through a verified causal path in only "
            },
            {
              "type": "text",
              "text": "61.5%",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            },
            {
              "type": "text",
              "text": ", averaged over 11 frontier LLMs. OpenRCA 2.0 makes that gap measurable: 500 failures, each labelled with the path the fault actually took."
            }
          ]
        }
      ]
    },
    "right-answer-skipped-step--scene": {
      "id": "right-answer-skipped-step--scene",
      "type": "component",
      "definitionId": "right-answer-skipped-step--definition",
      "parameters": {
        "alt": "An agent's chain Seat, Order, Gateway is scored correct; the true chain runs Seat, Travel, Order, Gateway, and the agent skipped Travel."
      }
    },
    "right-answer-skipped-step--text-35": {
      "id": "right-answer-skipped-step--text-35",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "p-4",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Outcome-only grading scores this answer as a success: the agent names Seat, the service where the delay was injected, while its explanation skips Travel, the service the failure passed through (Figure 1)."
            }
          ]
        }
      ]
    },
    "the-cause-is-known--scene": {
      "id": "the-cause-is-known--scene",
      "type": "component",
      "definitionId": "the-cause-is-known--definition",
      "parameters": {
        "alt": "Telemetry fits two possible causes; the injected fault lands on Seat and the arrows turn to run forward from it."
      }
    },
    "the-cause-is-known--column-36": {
      "id": "the-cause-is-known--column-36",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "h-5",
          "type": "heading",
          "level": 3,
          "children": [
            {
              "type": "text",
              "text": "What the labels miss"
            }
          ]
        },
        {
          "id": "list-6",
          "type": "list",
          "ordered": false,
          "children": [
            {
              "id": "li-7",
              "type": "listItem",
              "children": [
                {
                  "id": "p-8",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Benchmarks inject a fault and record only the injected component as the answer; the derivation behind an answer is never examined."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-9",
              "type": "listItem",
              "children": [
                {
                  "id": "p-10",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Labelling the path from telemetry alone puts the annotator in the agent's seat: reasoning backward, while many faults produce similar telemetry."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-11",
              "type": "listItem",
              "children": [
                {
                  "id": "p-12",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "No single signal settles a step: a plausible chain may not have carried the failure, a co-occurrence may be coincidence, and aligned timing alone is not causation."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "the-cause-is-known--column-37": {
      "id": "the-cause-is-known--column-37",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "h-13",
          "type": "heading",
          "level": 3,
          "children": [
            {
              "type": "text",
              "text": "What the annotator knows"
            }
          ]
        },
        {
          "id": "p-14",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Fault-injection records hold the one thing the agent never sees: the intervention do(v_root) that started the cascade. With the cause given, labelling turns from inference into forward verification: check which downstream effects actually followed."
            }
          ]
        }
      ]
    },
    "the-cause-is-known--columns-38": {
      "id": "the-cause-is-known--columns-38",
      "type": "container",
      "only": [
        "web"
      ],
      "layout": "columns",
      "children": [
        "the-cause-is-known--column-36",
        "the-cause-is-known--column-37"
      ],
      "properties": {
        "columnWidths": [
          1,
          1
        ]
      }
    },
    "following-the-fault-forward--text-39": {
      "id": "following-the-fault-forward--text-39",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "p-15",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "PAVE (Path Annotation via Verified Effects) starts from the recorded intervention and admits a path only when three conditions hold together:"
            }
          ]
        },
        {
          "id": "list-16",
          "type": "list",
          "ordered": true,
          "children": [
            {
              "id": "li-17",
              "type": "listItem",
              "children": [
                {
                  "id": "p-18",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Structure.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " The hop is a transition backed by a known propagation mechanism in the system's dependency graph (Phase 1, Structural Pruning)."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-19",
              "type": "listItem",
              "children": [
                {
                  "id": "p-20",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Statistics.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Every service on the path deviates from a pre-injection baseline collected on a fresh, warmed-up instance (Phase 2, Causal Verification)."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-21",
              "type": "listItem",
              "children": [
                {
                  "id": "p-22",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Time.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Every downstream anomaly starts no earlier than its upstream cause."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "p-23",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Across TrainTicket, the OpenTelemetry Demo and DeathStarBench Hotel Reservation, 27 fault types and 8,137 injected runs, this yields 500 failures with 7.5 verified causal edges on average. A two-annotator audit of 100 random instances agreed with the verified graph in 94."
            }
          ]
        }
      ]
    },
    "following-the-fault-forward--image-40": {
      "id": "following-the-fault-forward--image-40",
      "type": "image",
      "only": [
        "web"
      ],
      "assetId": "following-the-fault-forward--asset-1",
      "alt": "PAVE's two phases on a TrainTicket example: raw graph, after structural pruning, verified chain",
      "caption": [
        {
          "type": "text",
          "text": "Figure 3: structural pruning removes edges the topology forbids; causal verification drops Route, whose deviation matches baseline noise."
        }
      ],
      "width": 100,
      "alignment": "center"
    },
    "following-the-fault-forward--scene": {
      "id": "following-the-fault-forward--scene",
      "type": "component",
      "definitionId": "following-the-fault-forward--definition",
      "parameters": {
        "alt": "PAVE checks each hop for topology, baseline deviation and time order; the verified chains stack into OpenRCA 2.0's 500 failures."
      }
    },
    "grading-the-chain--scene": {
      "id": "grading-the-chain--scene",
      "type": "component",
      "definitionId": "grading-the-chain--definition",
      "parameters": {
        "alt": "A grid of 200 small chains: 76.0% name a correct root-cause service, 61.5% connect it to the symptom."
      }
    },
    "grading-the-chain--text-41": {
      "id": "grading-the-chain--text-41",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "p-24",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "The exact root-cause set is recovered in only 20.7% of cases on average (best 29.4%, Gemini 3.1 Pro). The process layer shows where the reasoning breaks:"
            }
          ]
        },
        {
          "id": "list-25",
          "type": "list",
          "ordered": false,
          "children": [
            {
              "id": "li-26",
              "type": "listItem",
              "children": [
                {
                  "id": "p-27",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Edges trail nodes.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Mean Edge F1 is 43.4% against Node F1 62.2%, for every model: agents find the services involved more reliably than the direction of the fault between them."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-28",
              "type": "listItem",
              "children": [
                {
                  "id": "p-29",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Equal scores, different reasoning.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Qwen3.6-Max grounds 91% of its correct services in a path; Claude Sonnet 4.6, with comparable F1, 66%."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-30",
              "type": "listItem",
              "children": [
                {
                  "id": "p-31",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Three habits behind ungrounded answers.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Stopping at the first plausible cause, reading a silent (killed) service as healthy, and following the loudest downstream signal."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "p-32",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Outcome scores alone hide every one of these failures; grading the path against verified ground truth makes them visible."
            }
          ]
        }
      ]
    },
