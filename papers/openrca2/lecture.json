  "narrations": {
    "right-answer-skipped-step--outcome--narration": {
      "id": "right-answer-skipped-step--outcome--narration",
      "content": [
        {
          "type": "text",
          "text": "An AI agent diagnoses a failing train-ticket system and names the right culprit, the Seat service. The benchmark marks it correct."
        }
      ]
    },
    "right-answer-skipped-step--truth--narration": {
      "id": "right-answer-skipped-step--truth--narration",
      "content": [
        {
          "type": "text",
          "text": "Yet the failure reached users through Travel, and the agent's explanation skips Travel entirely."
        }
      ]
    },
    "the-cause-is-known--forward--narration": {
      "id": "the-cause-is-known--forward--narration",
      "content": [
        {
          "type": "text",
          "text": "Benchmarks never checked the path, because from telemetry alone many faults look alike. But every benchmark failure is injected on purpose. Whoever labels it knows the cause, and can follow it forward."
        }
      ]
    },
    "following-the-fault-forward--verify--narration": {
      "id": "following-the-fault-forward--verify--narration",
      "content": [
        {
          "type": "text",
          "text": "That is what PAVE does. From the injected fault, it keeps a hop only if the system's topology allows it, the next service departs from its normal baseline, and the effect comes after its cause."
        }
      ]
    },
    "following-the-fault-forward--benchmark--narration": {
      "id": "following-the-fault-forward--benchmark--narration",
      "content": [
        {
          "type": "text",
          "text": "Fault after fault, the verified chains become the "
        },
        {
          "type": "pronunciation",
          "display": "OpenRCA 2.0",
          "spoken": "Open R C A two point oh"
