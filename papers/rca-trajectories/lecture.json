          "id": "correct"
        },
        {
          "id": "failed"
        }
      ],
      "data": {
        "plugin": "presmium.motion",
        "name": "PmScene",
        "durations": [
          8916,
          6687
        ],
        "fallback": {
          "type": "root",
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "Each dot is one round of tool calls, placed by its service's distance from the root cause, solid when it acted on the previous result. An illustrative correct ThinkDepth.ai · Sonnet run stays on the path for 31 rounds and ends on the root; a failed run spends about a third of its 38 rounds off the path and ends there (mean rounds from Table 2, shares from Figure 5a)."
                }
              ]
            }
          ]
        },
        "language": "typescript"
      }
    },
