        ],
        "fallback": {
          "type": "root",
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "Outcome metrics record only the final answer, the affected service, scored wrong. The trajectory shows the agent ranking services by error count (steps 4–7), hypothesizing the affected service (9–13), querying to confirm it (16–30), reaching the root cause at steps 37–40 without querying its metrics, and rechecking the symptom before answering (45–47)."
                }
              ]
            }
          ]
        },
        "language": "typescript"
      }
    },
    "on-the-path-or-off-it--definition": {
