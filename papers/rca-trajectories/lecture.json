          "id": "families"
        }
      ],
      "data": {
        "plugin": "presmium.motion",
        "name": "PmScene",
        "durations": [
          8916,
          6687
        ],
        "fallback": {
          "type": "root",
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "A disk fault on tidb-tikv-0 slows the product page (p99 0.25 s → 10 s). The baseline agent searches only the service tier and blames Ad, whose errors (0.25% → 0.69%) are chronic noise. Its six coded failures fall into three families: never gathered (OMIT1, OMIT3, OMIT5, OMIT6), gathered but misread (MIS2), reasoning off the evidence (GEN3)."
                }
              ]
            }
          ]
        },
        "language": "typescript"
      }
    },
    "guarded-runs-find-it--definition": {
      "id": "guarded-runs-find-it--definition",
      "kind": "scene",
      "schemaVersion": 1,
      "implementation": {
        "type": "file",
