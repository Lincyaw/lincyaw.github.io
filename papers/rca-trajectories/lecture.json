      "parameters": {
        "alt": "An outcome card scores the answer 'affected service' wrong; the agent's footprints on the fault path show it reached the root cause at steps 37–40 and left without querying its metrics."
      }
    },
    "on-the-path-or-off-it--text-24": {
      "id": "on-the-path-or-off-it--text-24",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "h-6",
          "type": "heading",
          "level": 3,
          "children": [
            {
              "type": "text",
              "text": "Grading the process"
            }
          ]
        },
        {
          "id": "list-7",
          "type": "list",
          "ordered": false,
          "children": [
            {
              "id": "li-8",
              "type": "listItem",
              "children": [
                {
                  "id": "p-9",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Ground truth.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " 500 RCABench incidents on TrainTicket, each with a manually validated service-level fault propagation path from the root cause to the alarming service; two reviewers agree on 97.4% of decisions."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-10",
              "type": "listItem",
              "children": [
                {
                  "id": "p-11",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Trajectories.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " 5,000 runs from ten configurations: nine agent frameworks under Qwen 3.5-Plus, and ThinkDepth.ai under Claude Sonnet 4.6."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-12",
              "type": "listItem",
              "children": [
                {
                  "id": "p-13",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Labels.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Each round is placed on or off the fault's path and gets one of 10 navigation moves and one of 4 evidence-use labels; 92,501 SQL actions each carry one of 11 SRE diagnostic intents."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "on-the-path-or-off-it--text-25": {
      "id": "on-the-path-or-off-it--text-25",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "h-14",
          "type": "heading",
          "level": 3,
          "children": [
            {
              "type": "text",
              "text": "What separates correct runs"
            }
          ]
        },
        {
          "id": "list-15",
          "type": "list",
          "ordered": false,
          "children": [
            {
              "id": "li-16",
              "type": "listItem",
              "children": [
                {
                  "id": "p-17",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "They use their evidence.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Correct runs re-query services on the path and act on what returns; failed runs Stray, Wander and Retrace, and more often hit empty or ignored results."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-18",
              "type": "listItem",
              "children": [
                {
                  "id": "p-19",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "The backbone shapes the search.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Sonnet acts on the previous result in 54.3% of rounds, Qwen in 24.9%; Sonnet pivots to resource and topology queries (resource_probe in 82.8% of its trajectories, Qwen 16.6%)."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-20",
              "type": "listItem",
              "children": [
                {
                  "id": "p-21",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "More rounds do not help.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Within a framework, failed runs take up to 11.4 more rounds than correct ones and still score lower on both F1 metrics."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-22",
              "type": "listItem",
              "children": [
                {
                  "id": "p-23",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Links are harder than services.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Edge F1 trails Node F1 in every configuration and stays at or below 0.67 even on correctly localized cases."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "on-the-path-or-off-it--columns-26": {
      "id": "on-the-path-or-off-it--columns-26",
      "type": "container",
      "only": [
