  "narrations": {
    "it-reached-the-cause-then-left--score--narration": {
      "id": "it-reached-the-cause-then-left--score--narration",
      "content": [
        {
          "type": "text",
          "text": "An AI agent investigates a failing microservice system and answers: the affected service. Wrong, and the score records nothing else."
        }
      ]
    },
    "it-reached-the-cause-then-left--walk--narration": {
      "id": "it-reached-the-cause-then-left--walk--narration",
      "content": [
        {
          "type": "text",
          "text": "By step 37 it stood on the real root cause, left its metrics unread, and walked back."
        }
      ]
    },
    "on-the-path-or-off-it--correct--narration": {
      "id": "on-the-path-or-off-it--correct--narration",
      "content": [
        {
          "type": "text",
          "text": "Plot each round by its distance from the fault's root. Correct runs keep re-querying the path and use what returns."
        }
      ]
    },
    "on-the-path-or-off-it--failed--narration": {
      "id": "on-the-path-or-off-it--failed--narration",
      "content": [
        {
          "type": "text",
          "text": "Failed runs stray off the path, ignore what they found, and run longer."
        }
      ]
    },
    "three-ways-to-miss--incident--narration": {
      "id": "three-ways-to-miss--incident--narration",
      "content": [
        {
          "type": "text",
          "text": "Here, the agent trusts the noisiest service, skips its healthy baseline, and never probes storage."
        }
      ]
    },
    "three-ways-to-miss--families--narration": {
      "id": "three-ways-to-miss--families--narration",
      "content": [
        {
          "type": "text",
          "text": "Across 154 failed runs, misses fall into three families: evidence never gathered, misread, or left behind by the reasoning."
        }
      ]
    },
    "guarded-runs-find-it--guard--narration": {
      "id": "guarded-runs-find-it--guard--narration",
      "content": [
        {
          "type": "text",
          "text": "DiagGuard maps the data first and checks plan and answer. The same agent now finds the storage node."
        }
      ]
    },
    "guarded-runs-find-it--gains--narration": {
      "id": "guarded-runs-find-it--gains--narration",
      "content": [
        {
          "type": "text",
          "text": "Across two benchmarks and six frameworks, accuracy rises in all fourteen setups. Read the trajectory: it shows where the diagnosis broke."
        }
      ]
    }
  },
