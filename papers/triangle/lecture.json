  "narrations": {
    "a-ticket-nobody-owns--hops--narration": {
      "id": "a-ticket-nobody-owns--hops--narration",
      "content": [
        {
          "type": "text",
          "text": "A customer can’t sign in on a Mac. The ticket goes to Team A, then B, then C, and every hop is more waiting while the service stays degraded."
        }
      ]
    },
    "a-ticket-nobody-owns--curve--narration": {
      "id": "a-ticket-nobody-owns--curve--narration",
      "content": [
        {
          "type": "text",
          "text": "Across thousands of teams, triage time climbs with every hop."
        }
      ]
    },
    "the-answer-isn-t-in-the-ticket--thin--narration": {
      "id": "the-answer-isn-t-in-the-ticket--thin--narration",
      "content": [
        {
          "type": "text",
          "text": "Why so many hops? The ticket alone can’t say who owns the problem; the clues sit in each team’s own logs, and someone has to go and look."
        }
      ]
    },
    "agents-go-and-look--analyze--narration": {
      "id": "agents-go-and-look--analyze--narration",
      "content": [
        {
          "type": "text",
          "text": "Triangle sends agents. An analyzer turns the ticket into key phrases; a decider shortlists teams from past incidents and team documents."
        }
      ]
    },
    "agents-go-and-look--vote--narration": {
      "id": "agents-go-and-look--vote--narration",
      "content": [
        {
          "type": "text",
          "text": "Each shortlisted team’s agent queries its own logs, writes what it found onto the ticket, and votes. No majority? The richer ticket gets a new shortlist."
        }
      ]
    },
    "fewer-hops-sooner--accuracy--narration": {
      "id": "fewer-hops-sooner--accuracy--narration",
      "content": [
        {
          "type": "text",
          "text": "Within five hops, Triangle routes 91.7 percent correctly, well ahead of "
        },
        {
          "type": "pronunciation",
          "display": "DeepCT",
          "spoken": "Deep C T"
        },
        {
          "type": "text",
          "text": ", which needs engineers to write those discussions."
        }
      ]
    },
    "fewer-hops-sooner--tte--narration": {
      "id": "fewer-hops-sooner--tte--narration",
      "content": [
        {
          "type": "text",
          "text": "In production, time to engage fell by up to 91 percent. What the ticket lacks, the teams’ agents can fetch."
        }
      ]
    }
  },
