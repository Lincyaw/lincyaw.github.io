      "caption": [
        {
          "type": "text",
          "text": "Figure 1: by hand, the incident passes three teams before Team C resolves it."
        }
      ],
      "width": 100,
      "alignment": "center",
      "only": [
        "web"
      ]
    },
    "the-answer-isn-t-in-the-ticket-image-11": {
