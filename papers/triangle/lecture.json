    "the-answer-isn-t-in-the-ticket--scene": {
      "id": "the-answer-isn-t-in-the-ticket--scene",
      "type": "component",
      "definitionId": "the-answer-isn-t-in-the-ticket--scene--definition",
      "parameters": {
