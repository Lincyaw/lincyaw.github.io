              "children": [
                {
                  "type": "text",
                  "text": "ACM DL"
                }
              ]
            },
            {
              "type": "text",
              "text": " · "
            },
            {
              "type": "link",
              "href": "https://arxiv.org/abs/2510.04711",
              "children": [
                {
                  "type": "text",
                  "text": "arXiv"
                }
              ]
            },
            {
              "type": "text",
              "text": " · "
            },
            {
              "type": "link",
              "href": "https://operationspai.github.io/revisiting-rca-evaluation/",
              "children": [
                {
                  "type": "text",
                  "text": "Project and code"
                }
              ]
            },
            {
              "type": "text",
              "text": " · "
