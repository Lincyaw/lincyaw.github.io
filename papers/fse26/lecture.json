        ],
        "language": "typescript",
        "fallback": {
          "type": "root",
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "On TrainTicket (50 services), an injected fault travels to the callers and the alerts pile up two hops from the cause; of 9,152 injections, the 1,430 failures users could feel are kept."
                }
              ]
            }
          ]
        }
      }
