        "durations": [
          7000,
          11000
        ],
        "language": "typescript",
        "fallback": {
          "type": "root",
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "A rule that blames the service with the most alerts matches Nezha on Nezha-TT (Top@1 0.93 vs 0.87, Table 2); in 86% of 737 public cases the fault is loud only where it was injected, or nowhere (Table 3)."
                }
              ]
            }
          ]
        }
      }
    },
    "faults-that-travel--scene--definition": {
