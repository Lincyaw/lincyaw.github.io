              "children": [
                {
                  "type": "text",
                  "text": "Artifact"
                }
              ]
            },
            {
              "type": "text",
              "text": " · "
            },
            {
              "type": "link",
              "href": "https://profile.aoyangfang.top/fse26-rca/",
              "children": [
                {
                  "type": "text",
                  "text": "Talk slides"
                }
              ]
            }
          ]
        },
        {
          "id": "p-3",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Public RCA benchmarks overstate how well root cause analysis works. On 1,430 failures that propagate like real incidents, 11 state-of-the-art models rank the true root cause first "
            },
            {
              "type": "text",
              "text": "21%",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            },
            {
              "type": "text",
              "text": " of the time; the best, MicroRCA, 37%."
            }
          ]
        }
      ]
    },
    "the-shortcut--scene": {
      "id": "the-shortcut--scene",
      "type": "component",
      "definitionId": "the-shortcut--scene--definition",
      "parameters": {
        "scene": "shortcut",
        "alt": "A rule that blames the service with the most alerts matches Nezha on Nezha-TT (Top@1 0.93 vs 0.87, Table 2); in 86% of 737 public cases the fault is loud only where it was injected, or nowhere (Table 3)."
      }
    },
    "shortcut-text": {
      "id": "shortcut-text",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "p-4",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "SimpleRCA, a rule that ranks services by their number of alerts, matches or beats state-of-the-art models on four widely used public benchmarks: Top@1 0.93 against Nezha's 0.87 on Nezha-TT, 0.83 against BARO's 0.50 on RE3-TT. It wins because in 86% of 737 cases from 11 public datasets the fault is loud only in the injected service, or in none, so the root cause is the loudest symptom and causal reasoning is never tested."
            }
          ]
        }
      ]
    },
    "shortcut-columns": {
      "id": "shortcut-columns",
      "type": "container",
      "only": [
        "web"
      ],
      "layout": "columns",
      "children": [
        "shortcut-old",
        "shortcut-new"
      ],
      "properties": {
        "columnWidths": [
          1,
          1
        ]
      }
    },
    "shortcut-old": {
      "id": "shortcut-old",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "h-5",
          "type": "heading",
          "level": 3,
          "children": [
            {
              "type": "text",
              "text": "Public benchmarks"
            }
          ]
        },
        {
          "id": "list-6",
          "type": "list",
          "ordered": false,
          "children": [
            {
              "id": "li-7",
              "type": "listItem",
              "children": [
                {
                  "id": "p-8",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Fewer than 200 cases in all but one"
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-9",
              "type": "listItem",
              "children": [
                {
                  "id": "p-10",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Faults reach 2–3 hops at most"
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-11",
              "type": "listItem",
              "children": [
                {
                  "id": "p-12",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "99% of cases miss some fault-relevant signal"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "shortcut-new": {
      "id": "shortcut-new",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "h-13",
          "type": "heading",
          "level": 3,
          "children": [
            {
              "type": "text",
              "text": "This benchmark"
            }
          ]
        },
        {
          "id": "list-14",
          "type": "list",
          "ordered": false,
          "children": [
            {
              "id": "li-15",
              "type": "listItem",
              "children": [
                {
                  "id": "p-16",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "1,430 validated failure cases"
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-17",
              "type": "listItem",
              "children": [
                {
                  "id": "p-18",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Call depth up to 7, 84% of services reached"
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-19",
              "type": "listItem",
              "children": [
                {
                  "id": "p-20",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "16.47 requests per second, against 0.14–4.35"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "faults-that-travel--scene": {
      "id": "faults-that-travel--scene",
      "type": "component",
      "definitionId": "faults-that-travel--scene--definition",
      "parameters": {
        "scene": "travel",
        "alt": "On TrainTicket (50 services), an injected fault travels to the callers and the alerts pile up two hops from the cause; of 9,152 injections, the 1,430 failures users could feel are kept."
      }
    },
    "travel-figure": {
      "id": "travel-figure",
      "type": "image",
      "only": [
        "web"
      ],
      "assetId": "pipeline-asset",
      "alt": "The closed-loop benchmark construction pipeline: load generator, TrainTicket, ChaosMesh injection, OpenTelemetry collection, validator and feedback",
      "caption": [
        {
          "type": "text",
          "text": "The closed loop that generates the benchmark (paper, Fig. 3)."
        }
      ],
      "width": 100,
      "alignment": "center"
    },
    "travel-steps": {
      "id": "travel-steps",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "p-21",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "A closed-loop generator makes faults propagate, so the cause is no longer the loudest symptom, and keeps a failure only when users would notice it."
            }
          ]
        },
        {
          "id": "list-22",
          "type": "list",
          "ordered": true,
          "children": [
            {
              "id": "li-23",
              "type": "listItem",
              "children": [
                {
                  "id": "p-24",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Load.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " TrainTicket, 50 services, driven by a state-machine workload."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-25",
              "type": "listItem",
              "children": [
                {
                  "id": "p-26",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Inject.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " 9,152 faults sampled from 31 types in 6 categories through ChaosMesh."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-27",
              "type": "listItem",
              "children": [
                {
                  "id": "p-28",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Observe.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Metrics, logs, traces and network telemetry through OpenTelemetry."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-29",
              "type": "listItem",
              "children": [
                {
                  "id": "p-30",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Validate.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Z-tests on user-facing SLIs; 84.4% of first injections are filtered out."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-31",
              "type": "listItem",
              "children": [
                {
                  "id": "p-32",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Label.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " 1,430 cases, each labelled from the service down to the function."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "the-scores-fall--scene": {
      "id": "the-scores-fall--scene",
      "type": "component",
      "definitionId": "the-scores-fall--scene--definition",
      "parameters": {
        "scene": "scores",
        "alt": "Top@1 of 11 state-of-the-art models on the new benchmark (Table 5): the best, MicroRCA, 0.37; the average 0.21; the alert rule 0.28. The pointer lands on the loudest service, not the cause."
      }
    },
    "scores-text": {
      "id": "scores-text",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "p-33",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "The rule that scored 0.93 before falls to 0.28. The 11 models average 0.21 Top@1, and running time grows from seconds to hours: CausalRCA needs 927 s for each 8-minute window."
            }
          ]
        },
        {
          "id": "table-34",
          "type": "table",
          "headerRows": 1,
          "children": [
            {
              "id": "tr-35",
              "type": "tableRow",
              "children": [
                {
                  "id": "td-36",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "Goal"
                    }
                  ]
                },
                {
                  "id": "td-37",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "Best model"
                    }
                  ]
                },
                {
                  "id": "td-38",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "Score"
                    }
                  ]
                }
              ]
            },
            {
              "id": "tr-39",
              "type": "tableRow",
              "children": [
                {
                  "id": "td-40",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "Right service first (Top@1)"
                    }
                  ]
                },
                {
                  "id": "td-41",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "MicroRCA"
                    }
                  ]
                },
                {
                  "id": "td-42",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "0.37"
                    }
                  ]
                }
              ]
            },
            {
              "id": "tr-43",
              "type": "tableRow",
              "children": [
                {
                  "id": "td-44",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "In the top three (Top@3)"
                    }
                  ]
                },
                {
                  "id": "td-45",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "MicroDig"
                    }
                  ]
                },
                {
                  "id": "td-46",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "0.61"
                    }
                  ]
                }
              ]
            },
            {
              "id": "tr-47",
              "type": "tableRow",
              "children": [
                {
                  "id": "td-48",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "In the top five (Top@5), fastest"
                    }
                  ]
                },
                {
                  "id": "td-49",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "SimpleRCA"
                    }
                  ]
                },
                {
                  "id": "td-50",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "0.80, 0.90 s"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "p-51",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "No single model wins every fault type. In the 262 hardest cases, the misses fall into three patterns, each pointing to what the next methods need:"
            }
          ]
        },
        {
          "id": "list-52",
          "type": "list",
          "ordered": false,
          "children": [
            {
              "id": "li-53",
              "type": "listItem",
              "children": [
                {
                  "id": "p-54",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Modeling bottlenecks, 47.4%.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " A model's assumption breaks: Nezha expects a fault to raise event frequency, and PodKill does not."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-55",
              "type": "listItem",
              "children": [
                {
                  "id": "p-56",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Scalability issues, 39.8%.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Methods slow down or fail on 50 services under real load."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-57",
              "type": "listItem",
              "children": [
                {
                  "id": "p-58",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Observability blind spots, 12.9%.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " The cause leaves no signal the model reads."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "p-59",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "The benchmark, its generator and the 11 re-engineered models are public, so the next RCA method can be measured on failures that travel."
            }
          ]
        }
      ]
    },
