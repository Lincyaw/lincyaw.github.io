    "who-gets-blamed--scene": {
      "id": "who-gets-blamed--scene",
      "type": "component",
      "definitionId": "who-gets-blamed--scene--definition",
      "parameters": {
        "scene": "blamed",
        "alt": "A service call graph: a fault rings one service, its alerts stack up, and an RCA model points at it: the cause, or just the loudest?"
      }
    },
    "blamed-card": {
      "id": "blamed-card",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "p-1",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Aoyang Fang",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            },
            {
              "type": "text",
              "text": ", Songhan Zhang, Yifan Yang, Haotong Wu, Junjielong Xu, Xuyang Wang, Rui Wang, Manyi Wang, Qisheng Lu, Pinjia He. "
            },
            {
              "type": "text",
              "text": "Proc. ACM Softw. Eng.",
              "marks": [
                {
                  "type": "italic"
                }
              ]
            },
            {
              "type": "text",
              "text": " 3(FSE), 1605–1627, 2026. Direct accept, 87 of 920."
            }
          ]
        },
        {
          "id": "p-2",
          "type": "paragraph",
          "children": [
            {
              "type": "link",
              "href": "https://dl.acm.org/doi/pdf/10.1145/3797100",
