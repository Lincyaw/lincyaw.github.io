  "blocks": {
    "a-trace-that-looks-fine--text-27": {
      "id": "a-trace-that-looks-fine--text-27",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "p-1",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Yifan Yang, "
            },
            {
              "type": "text",
              "text": "Aoyang Fang",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            },
            {
              "type": "text",
              "text": ", Songhan Zhang, Pinjia He. "
            },
            {
              "type": "text",
              "text": "ISSTA 2026",
              "marks": [
                {
                  "type": "italic"
                }
              ]
            },
            {
              "type": "text",
              "text": ". Direct accept, one of 90 among 888 papers."
            }
          ]
        },
        {
          "id": "p-2",
          "type": "paragraph",
          "children": [
            {
              "type": "link",
              "href": "https://arxiv.org/abs/2604.16810",
              "children": [
                {
                  "type": "text",
                  "text": "arXiv"
                }
              ]
            },
            {
              "type": "text",
              "text": " · "
            },
            {
              "type": "link",
              "href": "https://arxiv.org/pdf/2604.16810",
              "children": [
                {
                  "type": "text",
                  "text": "PDF"
                }
              ]
            },
            {
              "type": "text",
              "text": " · "
            },
            {
              "type": "link",
              "href": "https://github.com/OperationsPAI/Gleaner",
              "children": [
                {
                  "type": "text",
                  "text": "Code"
                }
              ]
            },
            {
              "type": "text",
              "text": " · "
            },
            {
              "type": "link",
              "href": "https://doi.org/10.5281/zenodo.19637628",
              "children": [
                {
                  "type": "text",
                  "text": "Dataset"
                }
              ]
            }
          ]
        },
        {
          "id": "p-3",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "A 1% sample chosen by Gleaner makes root cause analysis more accurate than all the traces: ShapleyIQ ranks the true root cause first in "
            },
            {
              "type": "text",
              "text": "0.56",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            },
            {
              "type": "text",
              "text": " of the failures on Gleaner's 1% sample, against "
            },
            {
              "type": "text",
              "text": "0.41",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            },
            {
              "type": "text",
              "text": " on the unsampled data (Table 6). Gleaner reads each trace together with its logs and decides in 0.741 ms per trace."
            }
          ]
        }
      ]
    },
    "a-trace-that-looks-fine--scene": {
      "id": "a-trace-that-looks-fine--scene",
      "type": "component",
      "definitionId": "a-trace-that-looks-fine--definition",
      "parameters": {
        "alt": "A large bin of all traces and a thin 1% bin, the thin one's diagnosis dial higher; then one trace whose spans are all OK hides two ERROR log lines."
      }
    },
    "a-trace-that-looks-fine--text-28": {
      "id": "a-trace-that-looks-fine--text-28",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "p-4",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "The trace is Fig. 1 of the paper: every span reports OK and the root span takes 47 ms, while its logs record a price configuration that failed to parse and a fallback price."
            }
          ]
        }
      ]
    },
    "why-samplers-drop-it--scene": {
      "id": "why-samplers-drop-it--scene",
      "type": "component",
      "definitionId": "why-samplers-drop-it--definition",
      "parameters": {
        "alt": "A fast sampler reads only calls, status and latency and discards the trace; a log-aware sampler builds a graph for a trained network while traces queue."
      }
    },
    "why-samplers-drop-it--column-29": {
      "id": "why-samplers-drop-it--column-29",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "h-5",
          "type": "heading",
          "level": 3,
          "children": [
            {
              "type": "text",
              "text": "Built for speed"
            }
          ]
        },
        {
          "id": "p-6",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Tail-based samplers that run online judge a trace by its call structure, span status and latency. A trace whose spans all report OK at normal latency looks routine to them, even when its logs record the failure."
            }
          ]
        }
      ]
    },
    "why-samplers-drop-it--column-30": {
      "id": "why-samplers-drop-it--column-30",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "h-7",
          "type": "heading",
          "level": 3,
          "children": [
            {
              "type": "text",
              "text": "Built to read logs"
            }
          ]
        },
        {
          "id": "p-8",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Samplers that also read log events rely on heterogeneous graph neural networks. They need offline training and are too slow for online, high-throughput use."
            }
          ]
        }
      ]
    },
    "why-samplers-drop-it--columns-31": {
      "id": "why-samplers-drop-it--columns-31",
      "type": "container",
      "only": [
        "web"
      ],
      "layout": "columns",
      "children": [
        "why-samplers-drop-it--column-29",
        "why-samplers-drop-it--column-30"
      ],
      "properties": {
        "columnWidths": [
          1,
          1
        ]
      }
    },
    "why-samplers-drop-it--text-32": {
      "id": "why-samplers-drop-it--text-32",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "p-9",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Sampling itself is unavoidable: trace volume reaches terabytes a day, and in Train-Ticket the top 24.3% of execution paths account for 82.3% of traces, so random sampling keeps the common and drops the rare."
            }
          ]
        }
      ]
    },
    "traces-as-sets-of-pairs--text-33": {
      "id": "traces-as-sets-of-pairs--text-33",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "p-10",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Gleaner replaces the graph with a set. Each trace becomes an event-pair set: bi-grams over every span's start, log templates, error and slowdown markers and end, plus links from each parent's end to its child's start. Similar traces share pairs, so comparing two traces is a Jaccard computation."
            }
          ]
        },
        {
          "id": "list-11",
          "type": "list",
          "ordered": true,
          "children": [
            {
              "id": "li-12",
              "type": "listItem",
              "children": [
                {
                  "id": "p-13",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Trace Encoder.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Builds the set and an anomaly score from span errors, WARN and ERROR log counts, and latency above 1.2 times the group's p90."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-14",
              "type": "listItem",
              "children": [
                {
                  "id": "p-15",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Quota Allocator.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Groups traces by entry API; when an alarm fires it raises the budget if traffic drops and boosts the alerted API up to 3 times the average, under a cap."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-16",
              "type": "listItem",
              "children": [
                {
                  "id": "p-17",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "DPP Selector.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Keeps traces that are anomalous and diverse with a fast greedy Determinantal Point Process; early termination and a cross-batch similarity cache with a 91.8% hit rate keep it online."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "traces-as-sets-of-pairs--image-34": {
      "id": "traces-as-sets-of-pairs--image-34",
      "type": "image",
      "only": [
        "web"
      ],
      "assetId": "traces-as-sets-of-pairs--asset-1",
      "alt": "Gleaner's pipeline: trace encoder, quota allocator with normal, buffer and alarm periods, DPP selector, backend storage",
      "caption": [
        {
          "type": "text",
          "text": "Fig. 2: from a trace with log events to the scored event-pair set, the per-API quota and the selected sample."
        }
      ],
      "width": 100,
      "alignment": "center"
    },
    "traces-as-sets-of-pairs--scene": {
      "id": "traces-as-sets-of-pairs--scene",
      "type": "component",
      "definitionId": "traces-as-sets-of-pairs--definition",
      "parameters": {
        "alt": "The trace becomes a set of event pairs that shares one pair with a healthy trace; grouped by API, an alarm raises one group's quota and the selector keeps unusual, diverse traces."
      }
    },
    "one-percent-better-diagnosis--scene": {
      "id": "one-percent-better-diagnosis--scene",
      "type": "component",
      "definitionId": "one-percent-better-diagnosis--definition",
      "parameters": {
        "alt": "ShapleyIQ's top-1 accuracy: 0.41 on all traces, 0.56 on Gleaner's 1% sample."
      }
    },
    "one-percent-better-diagnosis--text-35": {
      "id": "one-percent-better-diagnosis--text-35",
      "type": "text",
      "only": [
        "web"
      ],
      "content": [
        {
          "id": "list-18",
          "type": "list",
          "ordered": false,
          "children": [
            {
              "id": "li-19",
              "type": "listItem",
              "children": [
                {
                  "id": "p-20",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Better diagnosis on less data.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " On the 1% sample, ShapleyIQ's top-1 accuracy is 0.56 against 0.41 unsampled, and Nezha's 0.19 against 0.11; MicroRCA matches its unsampled accuracy with 99% less data (Table 6)."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-21",
              "type": "listItem",
              "children": [
                {
                  "id": "p-22",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "More of the rare behaviour kept.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " At a 10% rate, Trace Pattern Coverage is 11.6% to 128.7% higher and Shannon entropy 2.8% to 32.9% higher than the baselines'."
                    }
                  ]
                }
              ]
            },
            {
              "id": "li-23",
              "type": "listItem",
              "children": [
                {
                  "id": "p-24",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "Fast and on budget.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " 0.741 ms per trace against TracePicker's 1.008 ms, the highest benefit-cost ratio (0.81), and exactly the 5% rate asked for (Table 8)."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "p-25",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Anomaly priority and diversity work only together: each alone fails to beat the full data. The gains are largest in systems with several entry APIs and rich in-span events. The benchmark behind these numbers, 161 fault-injection cases and over 1.4 million traces, is public with the code."
            }
          ]
        }
      ]
    },
