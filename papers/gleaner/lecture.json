  "narrations": {
    "a-trace-that-looks-fine--bins--narration": {
      "id": "a-trace-that-looks-fine--bins--narration",
      "content": [
        {
          "type": "text",
          "text": "Keep the right one percent of your traces, and you can diagnose failures better than with all of them. The question is which."
        }
      ]
    },
    "a-trace-that-looks-fine--trace--narration": {
      "id": "a-trace-that-looks-fine--trace--narration",
      "content": [
        {
          "type": "text",
          "text": "This trace reports success at normal speed, yet hides an error log inside."
        }
      ]
    },
    "why-samplers-drop-it--lanes--narration": {
      "id": "why-samplers-drop-it--lanes--narration",
      "content": [
        {
          "type": "text",
          "text": "Fast samplers read only calls, status and latency, so they drop it. Samplers that do read logs turn every trace into a graph for a trained neural network, too slow for a live stream."
        }
      ]
    },
    "traces-as-sets-of-pairs--set--narration": {
      "id": "traces-as-sets-of-pairs--set--narration",
      "content": [
        {
          "type": "text",
          "text": "Gleaner skips the graph: each trace becomes a set of event pairs, a call followed by a log line, so similar traces simply share pairs."
        }
      ]
    },
    "traces-as-sets-of-pairs--select--narration": {
      "id": "traces-as-sets-of-pairs--select--narration",
      "content": [
        {
          "type": "text",
          "text": "Per API, alarms raise the quota, and a selector keeps traces both unusual and unlike each other. This trace's error log makes it stand out."
        }
      ]
    },
    "one-percent-better-diagnosis--result--narration": {
      "id": "one-percent-better-diagnosis--result--narration",
      "content": [
        {
          "type": "text",
          "text": "On Gleaner's one percent, the RCA tool ShapleyIQ ranks the true root cause first 56 percent of the time; on every trace, 41. Chosen well, a sample does not just save storage. It improves the diagnosis."
        }
      ]
    }
  },
