{
  "schemaVersion": 1,
  "name": "pixel",
  "extends": "docs",
  "params": {
    "typography": "sans",
    "contentWidth": "comfortable"
  },
  "tokens": {
    "font-sans": "'IBM Plex Sans', system-ui, sans-serif",
    "font-mono": "'IBM Plex Mono', ui-monospace, monospace",
    "radius-card": "0",
    "radius-chip": "0",
    "radius-control": "0",
    "radius-panel": "0",
    "radius-small": "0",
    "radius-tool": "0",
    "radius-sheet": "0",
    "color-bg": "#ffffff",
    "color-surface": "#ffffff",
    "color-sunk": "#f3f3f5",
    "color-chrome": "#ffffff",
    "color-code": "#f7f7f9",
    "color-ink": "#17171c",
    "color-muted": "#5a5a66",
    "color-muted-soft": "#f3f3f5",
    "color-line": "#dcdce2",
    "color-line-strong": "#17171c",
    "color-accent": "#2546b8",
    "color-accent-soft": "#e6ebfa",
    "color-on-accent": "#ffffff",
    "color-selected": "#e6ebfa",
    "shadow": "3px 3px 0 0 #17171c",
    "shadow-float": "5px 5px 0 0 #17171c"
  },
  "dark": {
    "color-bg": "#121216",
    "color-surface": "#1b1b21",
    "color-sunk": "#23232b",
    "color-chrome": "#121216",
    "color-code": "#1b1b21",
    "color-ink": "#ededf0",
    "color-muted": "#a6a6b2",
    "color-muted-soft": "#23232b",
    "color-line": "#33333d",
    "color-line-strong": "#ededf0",
    "color-accent": "#8ea6ff",
    "color-accent-soft": "#1f2747",
    "color-on-accent": "#0d0d12",
    "color-selected": "#1f2747",
    "shadow": "3px 3px 0 0 #000000",
    "shadow-float": "5px 5px 0 0 #000000"
  },
  "fonts": [
    "https://fonts.googleapis.com/css2?family=Silkscreen:wght@400;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
  ],
  "styles": [
    "./pixel.css"
  ]
}
